name: dockercompose11978854826951296341
services:
  eksisozlukclone.api.webapi:
    build:
      context: D:\github\EksiSozlukClone
      dockerfile: src/Api/WebApi/EksiSozlukClone.Api.WebApi/Dockerfile
    container_name: c_eksisozlukawebpi
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_URLS: http://+:8080
    image: eksisozlukcloneapiwebapi
    networks:
      blazor_backend: null
      blazor_frontend: null
    ports:
      - mode: ingress
        target: 8080
        published: "8080"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\Berfin\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Berfin\AppData\Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
